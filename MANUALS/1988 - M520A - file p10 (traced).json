   {"mm": [29.1, 412.6, 136.0, 419.1], "text": "WAAD-BECK SyStems LTD;"},
   {"mm": [111.0, 379.1, 199.3, 385.6], "text": "OPERATIONAL DESCRIPTION"},
   {"mm": [111.0, 366.8, 199.3, 373.8], "text": "M5204 MONQ INPUT MODULE"},
   {"mm": [104.9, 353.4, 203.8, 361.3], "text": "Refer to Module Layout B520-04-001"},
   {"mm": [58.7, 335.5, 97.6, 343.4], "text": "PAN SELECI"},
   {"mm": [58.1, 323.0, 176.8, 330.5], "text": "Pan insertion switch SW6 inserts the pan"},
   {"mm": [179.4, 323.4, 224.8, 329.4], "text": "control into the"},
   {"mm": [227.1, 322.3, 267.9, 329.5], "text": "left and right"},
   {"mm": [58.1, 317.6, 151.1, 324.5], "text": "output signal paths of the module:"},
   {"mm": [58.1, 305.7, 71.9, 312.2], "text": "PAD"},
   {"mm": [58.1, 290.8, 267.9, 299.9], "text": "Pad switch SW2 inserts a 20 dB loss pad into the microphone input signal"},
   {"mm": [58.1, 286.5, 113.8, 293.5], "text": "path: This typically"},
   {"mm": [115.3, 286.1, 174.2, 293.5], "text": "has application when"},
   {"mm": [176.0, 285.0, 250.4, 292.7], "text": "condenser microphones are"},
   {"mm": [251.7, 284.8, 268.1, 292.7], "text": "being"},
   {"mm": [58.7, 281.1, 73.0, 287.1], "text": "used."},
   {"mm": [58.3, 268.1, 88.1, 275.3], "text": "MCLLINE"},
   {"mm": [58.1, 254.8, 246.3, 262.4], "text": "Mic/Line selector SW3 determines whether the input source material"},
   {"mm": [247.9, 254.5, 267.5, 261.0], "text": "will be"},
   {"mm": [58.1, 248.5, 267.5, 256.4], "text": "from the microphone Or from the line. When the switch is released the source"},
   {"mm": [57.6, 242.7, 223.2, 250.1], "text": "selection is the microphone and when depressed it is the line."},
   {"mm": [58.7, 230.8, 70.6, 237.3], "text": "ALB"},
   {"mm": [58.7, 218.5, 89.8, 225.0], "text": "A/B source"},
   {"mm": [92.0, 218.5, 113.6, 224.5], "text": "selector"},
   {"mm": [115.7, 218.1, 201.7, 225.0], "text": "SWI when released sclects the"},
   {"mm": [215.5, 217.8, 233.2, 222.9], "text": "source"},
   {"mm": [235.5, 217.0, 267.5, 223.9], "text": "of the Mic"},
   {"mm": [57.6, 211.2, 267.1, 219.1], "text": "or Line input determined by the setting of SW3. When depressed and latched"},
   {"mm": [57.6, 205.8, 158.7, 212.7], "text": "the \"B\" Mic or Line source is selected_"},
   {"mm": [57.6, 193.4, 78.8, 200.4], "text": "PHASE"},
   {"mm": [57.4, 178.5, 267.1, 187.9], "text": "Phase reversal switch SW4 reverses the phase of audio signal path through"},
   {"mm": [57.6, 174.2, 165.6, 181.2], "text": "the M520 Input Module when depressed."},
   {"mm": [57.2, 161.9, 148.8, 168.9], "text": "PHASE REVERSAL INDICATOR"},
   {"mm": [56.3, 148.3, 229.3, 157.2], "text": "Phase reversal indicator DSZ illuminates when SW4 is depressed."},
   {"mm": [57.2, 137.1, 90.2, 144.1], "text": "PGMPEAK"},
   {"mm": [57.2, 123.9, 176.4, 131.8], "text": "This indicator DS3 illuminates green when"},
   {"mm": [177.9, 122.8, 266.6, 130.4], "text": "the level of the audio signal at"},
   {"mm": [56.6, 119.0, 88.7, 125.0], "text": "the module"},
   {"mm": [90.5, 117.4, 183.9, 125.1], "text": "insertion  point (prefade) is at or"},
   {"mm": [185.7, 117.4, 238.4, 123.9], "text": "above the nominal"},
   {"mm": [239.4, 115.7, 266.9, 124.6], "text": "operiting"},
   {"mm": [56.3, 111.8, 157.4, 119.2], "text": "level The  indicator will switch to"},
   {"mm": [160.2, 111.2, 231.2, 118.4], "text": "red   (overload) when the"},
   {"mm": [233.2, 110.1, 266.6, 117.3], "text": "signal  level"},
   {"mm": [56.3, 104.5, 243.5, 113.4], "text": "reaches the point where it is approximately 22 dB above the nominal"},
   {"mm": [56.6, 93.3, 103.4, 100.2], "text": "AUXILIARY ON"},
